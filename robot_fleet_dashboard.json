{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Fleet uptime",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"robot_fleet\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r.tenant_id == \"${tenant_id}\")\n  |> filter(fn: (r) => r._measurement == \"robot_status\" and r._field == \"status\")\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({ r with _value: if r._value == \"fault\" then 0.0 else 1.0 }))\n  |> mean()\n  |> map(fn: (r) => ({ r with _value: r._value * 100.0 }))"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Total tasks completed",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"robot_fleet\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r.tenant_id == \"${tenant_id}\")\n  |> filter(fn: (r) => r._measurement == \"tasks\" and r._field == \"completed_total\")\n  |> last()\n  |> group()\n  |> sum()"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Active faults",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"robot_fleet\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r.tenant_id == \"${tenant_id}\")\n  |> filter(fn: (r) => r._measurement == \"robot_status\" and r._field == \"status\")\n  |> last()\n  |> map(fn: (r) => ({ r with _value: if r._value == \"fault\" then 1 else 0 }))\n  |> group()\n  |> sum()"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Avg battery",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"robot_fleet\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r.tenant_id == \"${tenant_id}\")\n  |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"soc_pct\")\n  |> last()\n  |> group()\n  |> mean()"
        }
      ]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Robots online",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "green", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"robot_fleet\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r.tenant_id == \"${tenant_id}\")\n  |> filter(fn: (r) => r._measurement == \"robot_status\" and r._field == \"status\")\n  |> last()\n  |> group()\n  |> count()"
        }
      ]
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Battery state of charge — all robots",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"robot_fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.tenant_id == \"${tenant_id}\")\n  |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"soc_pct\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"battery\")"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Robot speed (m/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "unit": "velocityms",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"robot_fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.tenant_id == \"${tenant_id}\")\n  |> filter(fn: (r) => r._measurement == \"odometry\" and r._field == \"speed_ms\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"speed\")"
        }
      ]
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Tasks completed (cumulative)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"robot_fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.tenant_id == \"${tenant_id}\")\n  |> filter(fn: (r) => r._measurement == \"tasks\" and r._field == \"completed_total\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> yield(name: \"tasks\")"
        }
      ]
    },

    {
      "id": 9,
      "type": "table",
      "title": "Live robot status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "color-text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "fault":    { "text": "FAULT",    "color": "red",    "index": 0 },
                "charging": { "text": "CHARGING", "color": "orange", "index": 1 },
                "moving":   { "text": "MOVING",   "color": "blue",   "index": 2 },
                "idle":     { "text": "IDLE",     "color": "green",  "index": 3 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"robot_fleet\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r.tenant_id == \"${tenant_id}\")\n  |> filter(fn: (r) => r._measurement == \"robot_status\" and r._field == \"status\")\n  |> last()\n  |> keep(columns: [\"robot_id\", \"_value\", \"_time\"])\n  |> rename(columns: {_value: \"status\", _time: \"last seen\", robot_id: \"robot\"})"
        }
      ]
    },

    {
      "id": 10,
      "type": "table",
      "title": "Fault log",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }]
          }
        },
        "overrides": []
      },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"robot_fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.tenant_id == \"${tenant_id}\")\n  |> filter(fn: (r) => r._measurement == \"robot_status\" and r._field == \"fault_code\")\n  |> filter(fn: (r) => r._value != \"none\")\n  |> keep(columns: [\"robot_id\", \"_value\", \"_time\"])\n  |> rename(columns: {_value: \"fault code\", _time: \"timestamp\", robot_id: \"robot\"})\n  |> sort(columns: [\"timestamp\"], desc: true)\n  |> limit(n: 50)"
        }
      ]
    }

  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["robotics", "fleet", "observability"],
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"robot_fleet\", tag: \"tenant_id\", start: -30d)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Robot Fleet Observability",
  "uid": "robot-fleet-v1",
  "version": 1
}
