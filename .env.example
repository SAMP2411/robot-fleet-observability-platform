INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=replace-with-an-influxdb-api-token
INFLUX_ORG=startup-robot-dashboard
INFLUX_BUCKET=robot_fleet

SECRET_KEY=replace-with-a-long-random-value
INGEST_API_KEY=replace-with-a-separate-ingestion-key
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional local demo account. Leave DEMO_EMAIL and DEMO_PASSWORD empty to disable it.
DEMO_EMAIL=sam@fleetwatch.io
DEMO_PASSWORD=replace-with-a-demo-password
DEMO_COMPANY=FleetWatch
DEMO_TENANT_ID=tenant_fleetwatch

# Used by robot_sim.py; it must match the account/fleet being simulated.
TENANT_ID=tenant_fleetwatch
